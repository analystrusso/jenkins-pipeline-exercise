@Library('cicd-sharedlib')

pipeline {
    agent any
    environment {
        REMOTE_USER = 'root'
        REMOTE_IP = '67.205.183.170'
    }
    tools {
        nodejs "node"
    }
    stages {
        stage('Version') {
            steps {
                version('minor')
            } 
        }
        
        stage('Test') {
            steps {
                test()
            }
        }

        stage('Build and Push') {
            steps {
                buildpush('analystrusso/jenkins-exercise')
            }
        }

        stage('Commit version update') {
            steps {
                versioncommit('https://x-access-token:$GH_TOKEN@github.com/analystrusso/jenkins-pipeline-exercise.git')
            }
        }

        stage('Deploy on server') {
            steps {
                deploy()
            }
        }
    }
}