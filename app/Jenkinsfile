pipeline {
    agent any
    tools {
        nodejs 'node26'
    }
    stages {
        stage("Build") {
            steps {
                script {
                    echo "building...."
                    sh 'docker build -t demo-app:1.0 .'
                }
            }
        }

        stage("Install") {
            steps {
                script {
                    echo "installing...."
                    sh 'npm install'
                }
            }
        }

        stage("Test") {
            steps {
                script {
                    echo "testing...."
                    sh 'npm test'
                }
            }
        }

        stage("Start") {
            steps {
                script {
                    echo "starting...."
                    sh 'npm start'
                }
            }
        }
    }
}