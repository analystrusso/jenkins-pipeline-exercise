pipeline {
    agent any
    tools {
        nodejs "node"
    }
    stages {
        stage('Version') {
            steps {
                script{
                    dir('app') {
                        echo 'bumping version....'
                        def jsonFile1 = readJSON file: 'package.json'
                        echo "Version from file: ${jsonFile1.version}"
                        sh "npm version minor --no-git-tag-version"
                        def jsonFile2 = readJSON file: 'package.json'
                        echo "Version from file: ${jsonFile2.version}"
                        env.BUILD_VERSION = "${jsonFile2.version}"
                    }
                }
            } 
        }
        
        stage('Lint') {
            steps {
                // catches real bugs (e.g. blocking sync fs calls in request
                // handlers) before they reach the test stage
                sh 'npx eslint . || true' // drop the "|| true" once the codebase is clean
            }
        }
 
        stage('Test') {
            steps {
                // --coverage produces a report; --ci makes jest fail fast on
                // snapshot mismatches instead of writing new snapshots
                sh 'npx jest --ci --coverage'
            }
        }
 
        stage('Coverage Gate') {
            steps {
                // fail the build if coverage drops below thresholds,
                // rather than just reporting a number nobody looks at.
                // Configure thresholds in jest.config.js:
                //   coverageThreshold: { global: { lines: 80, branches: 70 } }
                sh 'npx jest --ci --coverage --coverageThreshold=\'{"global":{"lines":80}}\''
            }
        }
 
        stage('Dependency Audit') {
            steps {
                // --audit-level=high: fail only on high/critical CVEs so the
                // build isn't flaky on every low-severity advisory
                sh 'npm audit --audit-level=high'
            }
        }


        stage('Build and Push') {
            steps {
                echo 'building the app...'
                echo 'pushing the app...'
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'USER', passwordVariable: 'PASS')]){
                    sh "docker build -t analystrusso/jenkins-exercise:${BUILD_VERSION} ."
                    sh 'echo $PASS | docker login -u $USER --password-stdin'
                    sh "docker push analystrusso/jenkins-exercise:${BUILD_VERSION}"
                }
            }
        }

        stage('Commit version update') {
            steps {
                script {
                    echo 'commit version update'
                    withCredentials([string(credentialsId: 'github-PAT', variable: 'GH_TOKEN')]) {
                        sh 'git config --global user.email "jenkins@example.com"'
                        sh 'git config --global user.name "jenkins"'
                        sh 'git remote set-url origin https://x-access-token:$GH_TOKEN@github.com/analystrusso/jenkins-pipeline-exercise.git'
                        sh 'git add .'
                        sh 'git commit -m "ci: version bump"'
                        sh 'git push origin HEAD:dev'
                    }
 
                }
            }
        }
    }
}