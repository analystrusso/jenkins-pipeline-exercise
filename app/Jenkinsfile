pipeline {
    agent {
        label { image 'node:20-alpine' }
    }
    stages {
        stage("Install") {
            steps {
                script {
                    echo "installing...."
                    sh 'sudo apt update && apt install libatomic1'
                    sh 'npm ci'
                }
            }
        }

        stage("Test") {
            steps {
                script {
                    echo "testing...."
                    sh 'npm test'
                }
            }
        }

        stage("Start") {
            steps {
                script {
                    echo "starting...."
                    sh 'npm start'
                }
            }
        }
    }
}