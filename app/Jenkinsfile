pipeline {
    agent any
    tools {
        nodejs 'node26'
    }
    stages {
        stage("Build") {
            steps {
                script {
                    
                    echo "building the docker image..."
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-repo', passwordVariable: 'PASS', usernameVariable: 'USER')]) {
                    sh "docker build -t analystrusso/twn-bootcamp-repo:1.0 ."
                    sh 'echo $PASS | docker login -u $USER --password-stdin'
                    sh "docker push analystrusso/twn-bootcamp-repo:1.0"
                }
            }
        }
    }

        stage("Install") {
            steps {
                script {
                    echo "installing...."
                    sh 'npm install'
                }
            }
        }

        stage("Test") {
            steps {
                script {
                    echo "testing...."
                    sh 'npm test'
                }
            }
        }

        stage("Start") {
            steps {
                script {
                    echo "starting...."
                    sh 'npm start'
                }
            }
        }
    }
}